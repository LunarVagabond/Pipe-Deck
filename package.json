{
  "name": "pipe-deck",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:e2e": "playwright test --config src/e2e/playwright.config.ts",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "typecheck:e2e": "tsc -p src/e2e/tsconfig.json --noEmit",
    "screenshots": "node scripts/screenshot-app.mjs",
    "lint": "eslint src",
    "format": "prettier --write src scripts *.json *.md",
    "format:check": "prettier --check src scripts *.json *.md"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@tauri-apps/plugin-updater": "^2",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "html-to-image": "^1.11.13",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.1.10"
  }
}
